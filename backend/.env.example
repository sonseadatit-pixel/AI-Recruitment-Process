# Backend environment variables (copy to .env and fill in values)

# HTTP port for the Express API
PORT=5000

# Supabase project URL
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Supabase SERVICE ROLE key (server-side only, never expose in the frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic API key for Claude (AI screening, interview questions, summaries)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Claude model to use
CLAUDE_MODEL=claude-sonnet-4-5

# Mailgun webhook signing key (verify inbound email-to-CV webhooks).
# Found in the Mailgun dashboard under Sending → Webhooks.
MAILGUN_WEBHOOK_SIGNING_KEY=your-mailgun-webhook-signing-key
